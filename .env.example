# Copy to .env and fill in:
#   cp .env.example .env

APIFY_TOKEN=
OVERLEAF_GIT_TOKEN=
OVERLEAF_PROJECT_ID=

# Prep & CV agent backends (pick one via UI or AGENT_PROVIDER)
# cursor       = CURSOR_API_KEY (https://cursor.com/dashboard/integrations)
# claude-code  = claude on PATH (+ Anthropic login / ANTHROPIC_API_KEY)
# codex        = codex on PATH (+ OpenAI login / OPENAI_API_KEY)
AGENT_PROVIDER=cursor
CURSOR_API_KEY=
CURSOR_AGENT_MODEL=composer-2.5
# CLAUDE_CODE_BIN=
# CLAUDE_CODE_MODEL=
# CODEX_BIN=
# CODEX_MODEL=

# Google Sheets (direct API — no Zapier)
# 1) Create a Google Cloud service account + enable Google Sheets API
# 2) Download JSON key to secrets/google-sheets.json (gitignored)
# 3) Share your spreadsheet with the service account email (Editor)
# 4) Paste the spreadsheet ID from the URL
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS=secrets/google-sheets.json
GOOGLE_SHEETS_TAB=Applications
