# Per-user identity & local config — never commit these
profile.json
search-profile.json
profile.json.*
search-profile.json.*
profile.*.json
search-profile.*.json
!search-profile.example.json
cv/*
!cv/.gitkeep
!cv/README.md
!cv/resume.example.md
!cv/cover-letter.example.md
engineering.md
state/*
!state/*.example.json
!state/.gitkeep

# Local backups and exported documents can contain candidate data
/backups/
/outputs/
/work/
*.pdf
*.docx
*.bak
*.backup
*.tmp

# Retired personal overlay remains ignored if restored from an old backup.
.agents/skills/cv-tailor.local/

# Scratch output (fetched jobs, prep packs, Overleaf clone, tectonic — never commit)
.workspace/
.cv-workspace/

# Per-company CV exports: downloads/<Company>/<Name> CV.pdf — never commit
downloads/
scripts/__pycache__/
__pycache__/
*.pyc
.venv/
venv/
node_modules/

# Env / secrets
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.p12
*.pfx

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
