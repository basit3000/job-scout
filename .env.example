# Copy to .env and fill in:
#   cp .env.example .env

APIFY_TOKEN=
OVERLEAF_GIT_TOKEN=
OVERLEAF_PROJECT_ID=

# Prep & CV agent backends (pick one via UI or AGENT_PROVIDER)
# cursor       = CURSOR_API_KEY (https://cursor.com/dashboard/integrations)
# claude-code  = claude on PATH (+ Anthropic login / ANTHROPIC_API_KEY)
# codex        = codex on PATH (+ OpenAI login / OPENAI_API_KEY)
AGENT_PROVIDER=cursor
CURSOR_API_KEY=
CURSOR_AGENT_MODEL=composer-2.5
