# Copy to .env and fill in:
#   cp .env.example .env

APIFY_TOKEN=
OVERLEAF_GIT_TOKEN=
OVERLEAF_PROJECT_ID=
# Optional: local clone of your portfolio repo (src/data/projects.js, src/content/blog/*.md).
# The standalone evidence collector can read it; confirm new facts in Memory.
# Auto-detected when it sits next to this repo as ../portfolio; set it otherwise.
# PORTFOLIO_ROOT=../portfolio
# Optional: GitHub username for the standalone evidence collector.
# GITHUB_USERNAME=

# Web UI
# PORT=4040          # change if 4040 is taken
# NO_OPEN=1          # do not auto-open the browser on npm start
# CHROME_PATH=       # explicit Chrome/Edge binary for PDF export + Fill (auto-detected otherwise)
# JOB_SCOUT_PYTHON=  # optional Python executable; otherwise prefer the repo's .venv
# ALLOW_INSECURE_LOCAL_TRACKER=true  # development only: numeric loopback HTTP tracker
# JOB_SCOUT_NOTIFICATION_WEBHOOK=  # optional HTTPS webhook; separate UI consent required
# JOB_SCOUT_GMAIL_ACCESS_TOKEN=  # optional user-authorized gmail.compose OAuth token; drafts only

# Goose is the only agent runtime. Configure its provider/login/model with goose configure.
GOOSE_BIN=
# GOOSE_MODEL=  # optional override; otherwise use the configured Goose model

# Google Sheets (direct API — no Zapier)
# 1) Create a Google Cloud service account + enable Google Sheets API
# 2) Download JSON key to secrets/google-sheets.json (gitignored)
# 3) Share your spreadsheet with the service account email (Editor)
# 4) Paste the spreadsheet ID from the URL
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS=secrets/google-sheets.json
GOOGLE_SHEETS_TAB=Applications
