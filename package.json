{
  "name": "job-scout",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Local multi-country job scout — CLI + web UI",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "start": "node scripts/setup.mjs --quiet && node web/server.mjs",
    "dev": "npm start",
    "fetch": "node scripts/fetch-jobs.mjs",
    "evidence": "node scripts/build-evidence.mjs",
    "memory:migrate": "node scripts/migrate-memory.mjs",
    "privacy": "node scripts/check-privacy.mjs",
    "test": "node --test \"scripts/lib/*.test.mjs\"",
    "test:activity": "node --test scripts/ui/activity.test.mjs",
    "test:improvements": "node --test scripts/ui/improvements.test.mjs",
    "test:workspace": "node --test scripts/ui/workspace.test.mjs",
    "test:cloud-tracker": "node --test scripts/ui/cloud-tracker.test.mjs",
    "demo": "node --test scripts/ui/improvements.test.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:real": "node scripts/benchmark.mjs --real-model",
    "preversion": "npm test && npm run privacy"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "pdfjs-dist": "^4.10.38",
    "playwright-core": "^1.55.0"
  }
}
